# SMTP delivery configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=deliveries@example.com
SMTP_SSL=false
NOTIFICATION_EMAIL=deliveries@example.com

# Optional tracked mailbox intake
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Document storage: local for development, s3 for production
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_S3_BUCKET=
AWS_REGION=ap-southeast-2
AWS_ENDPOINT_URL=
# Optional; disabled when blank. Confirm Harmony retention policy before enabling.
DOCUMENT_RETENTION_DAYS=

# Shared SMS history database (same value as Sales Floor backend).
LEAD_CENTER_MONGO_URI=

# MobileMessage sender requested by Harmony. Incoming SMS is forwarded from this
# handset to /api/messages/inbound; keep that forwarding configured.
MOBILEMESSAGE_USERNAME=
MOBILEMESSAGE_PASSWORD=
MOBILEMESSAGE_FROM=+61408622037
MOBILEMESSAGE_API_URL=https://api.mobilemessage.com.au

MOBILEMESSAGE_SENDER_ID=+61408622037

# SalesLogs hourly import. Only Nunawading and Caroline Springs are imported.
# Set one seed source; rotated sessions are persisted privately outside Git.
SALESLOGS_COOKIE_FILE=.runtime/saleslogs/cookie.txt
# SALESLOGS_COOKIE=
SALESLOGS_SESSION_FILE=.runtime/saleslogs/session.json
SALESLOGS_DATA_DIR=.runtime/saleslogs
# SALESLOGS_PYTHON=/var/www/shaun-backend/venv/bin/python
