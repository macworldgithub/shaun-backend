# SMTP delivery configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=deliveries@example.com
SMTP_SSL=false
NOTIFICATION_EMAIL=deliveries@example.com

# Optional tracked mailbox intake
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Document storage: local for development, s3 for production
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_S3_BUCKET=
AWS_REGION=ap-southeast-2
AWS_ENDPOINT_URL=
# Optional; disabled when blank. Confirm Harmony retention policy before enabling.
DOCUMENT_RETENTION_DAYS=
